{
  "name": "@diegocoxta/sites",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "author": "Diego Costa <diego@diegocosta.com.br>",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegocoxta/sites"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:diegocosta.com.br": "DEV_SITE=diegocosta.com.br next dev --turbopack",
    "dev:diegocosta.me": "DEV_SITE=diegocosta.me next dev --turbopack",
    "dev:diegocoxta.com": "DEV_SITE=diegocoxta.com next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint-staged": "lint-staged",
    "prettier": "prettier --write .",
    "stylelint": "npx stylelint --fix '{components,app,lib}/**/*.css'",
    "prepare": "husky",
    "upgrade-latest": "yarn upgrade-interactive --latest",
    "cv": "cd public/diegocosta.com.br/pages/cv && npx md-to-pdf index.md --stylesheet pdf.css"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "kbar": "^1.0.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-plock": "^3.6.1",
    "reading-time": "^1.5.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.5",
    "sugar-high": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/rss": "^0.0.32",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "gray-matter/js-yaml": "^3.15.2"
  },
  "diegocoxta/npm-cool-off-upgrade": {
    "ignore": [
      "typescript"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
